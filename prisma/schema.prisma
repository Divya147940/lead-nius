generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Registration {
  id          Int       @id @default(autoincrement())
  fullName    String?   @map("fullname")
  linkedin    String?   @map("linkedin")
  startupName String?   @map("startupname")
  startupUrl  String?   @map("startupurl")
  stage       String?   @map("stage")
  industry    String?   @map("industry")
  lookingFor  String[]  @map("lookingfor")
  betaPerk    String?   @map("betaperk")
  timestamp   DateTime? @default(now()) @map("timestamp") @db.Timestamptz(6)

  @@map("registrations")
}
